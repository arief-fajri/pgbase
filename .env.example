# Copy this file to `.env` (which is git-ignored) and fill in real values
# before running `docker compose up`. Never commit `.env`.
#
# Generate a strong database password, e.g.:
#   openssl rand -base64 32
#
# docker-compose.yml fails fast if PB_POSTGRES_PASSWORD is unset, so there is
# no weak built-in default to accidentally ship to production.

# Database credentials (the app and the postgres container share this password).
PB_POSTGRES_USER=pgbase
PB_POSTGRES_PASSWORD=
PB_POSTGRES_DBNAME=pgbase

# Host port the postgres container is published on. It is bound to 127.0.0.1
# only (see docker-compose.yml), so the database is never exposed to the
# network. Change only if 5432 is already taken locally.
PB_POSTGRES_PORT=5432

# TLS mode for the app -> postgres connection.
#   - `disable`      : OK for the single-host docker-compose network below.
#   - `require`      : encrypt in transit (minimum for production).
#   - `verify-full`  : encrypt + verify the server cert (recommended for
#                      production / managed Postgres).
# Note: the bundled postgres:16-alpine image has no TLS configured, so keep
# `disable` for this local compose. For production point PB_POSTGRES_* at a
# TLS-enabled Postgres and set `require`/`verify-full`.
PB_POSTGRES_SSLMODE=disable
