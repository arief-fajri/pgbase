/.vscode/
.idea

.DS_Store

# goreleaser builds folder
/.builds/

# tests coverage
coverage.out

# local runtime data dir (created on first run)
/pb_data/

# plaintask todo files
*.todo

# generated markdown previews
README.html
CHANGELOG.html
LICENSE.html
.feature-plan

# SQLite sidecar files created when tests open a committed .db fixture
# (WAL index / rollback journal). Never committed; keep the tree clean so
# `goreleaser release --clean` doesn't abort on a dirty state.
*.db-shm
*.db-wal
*.db-journal