/.vscode/
.idea

.DS_Store

# goreleaser builds folder
/.builds/

# tests coverage
coverage.out

# local runtime data dir (created on first run)
/pb_data/

# runtime-generated migration dir + locally built binary
/pb_migrations/
/pgbase

# local secrets for docker-compose (copy .env.example -> .env and fill in);
# never commit real credentials. The committed template is .env.example.
.env
!.env.example

# plaintask todo files
*.todo

# generated markdown previews
README.html
CHANGELOG.html
LICENSE.html
.feature-plan

# docs site (isolated VitePress package; must stay untracked so
# `goreleaser release --clean` never aborts on a dirty tree)
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/*.timestamp-*.mjs

# SQLite sidecar files created when tests open a committed .db fixture
# (WAL index / rollback journal). Never committed; keep the tree clean so
# `goreleaser release --clean` doesn't abort on a dirty state.
*.db-shm
*.db-wal
*.db-journal